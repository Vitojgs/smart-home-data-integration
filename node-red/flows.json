        "func": "const h = msg.payload.hourly, out = [];\nconst LAT = msg.payload.latitude, LON = msg.payload.longitude, TZ = msg.payload.timezone;\nfor (let i = 0; i < h.time.length; i++) {\n    out.push({ timestamp: h.time[i], temperature_c: h.temperature_2m[i], humidity_pct: h.relative_humidity_2m[i], weather_code: h.weather_code[i], wind_kmh: h.wind_speed_10m[i], latitude: LAT, longitude: LON, timezone: TZ });\n}\nmsg.payload = out;\nreturn msg;",
