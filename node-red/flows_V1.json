    {
        "id": "3227d8583bea1124",
        "type": "function",
        "z": "ec9bc94cd09020cb",
        "name": "gera-H1",
        "func": "const start = new Date(2026, 0, 1, 0, 0, 0);\nconst out = [];\nconst n = 181 * 24;\nfor (let i = 0; i < n; i++) {\n     const ts = new Date(start.getTime() + i * 3600e3);\n    const hh = ts.getHours();\n    if (hh !== 8 && hh !== 14 && hh !== 22) continue;\n    const iso = ts.getFullYear() + \"-\" + String(ts.getMonth()+1).padStart(2,\"0\") + \"-\" +\n        String(ts.getDate()).padStart(2,\"0\") + \"T\" + String(ts.getHours()).padStart(2,\"0\") + \":00\";\n    const dayOfYear = Math.floor(i / 24);\n    const base = 17 + 7 * Math.sin((dayOfYear - 30) / 181 * Math.PI);\n    let t = base + (Math.random()-0.5)*2;\n    let h = 55 + (Math.random()-0.5)*15;\n    let p = Math.max(0, 400 + (t-20)*120 + (Math.random()-0.5)*300);\n    let co2 = 600 + Math.random()*500 + ((ts.getHours()>=19&&ts.getHours()<=23)?300:0);\n    out.push({timestamp:iso, device_id:\"TEMP-SA-01\", room:\"sala\", metric:\"temp_c\", value:t.toFixed(1)});\n    out.push({timestamp:iso, device_id:\"TEMP-SA-01\", room:\"sala\", metric:\"humidity_pct\", value:h.toFixed(0)});\n    out.push({timestamp:iso, device_id:\"PIR-SA-01\", room:\"sala\", metric:\"presence\", value:Math.random()<0.3?\"true\":\"false\"});\n    out.push({timestamp:iso, device_id:\"PLUG-CZ-01\", room:\"cozinha\", metric:\"power_w\", value:Math.round(Math.min(2500,p))});\n    out.push({timestamp:iso, device_id:\"AIR-QT-01\", room:\"quarto\", metric:\"co2_ppm\", value:Math.round(Math.min(1800,Math.max(400,co2)))});\n}\nfor (let k=0;k<out.length*0.05;k++) out[Math.floor(Math.random()*out.length)].value=\"\";\nfor (let k=0;k<20;k++) out.push(out[Math.floor(Math.random()*out.length)]);\nfor (let k=0;k<10;k++){let r=out[Math.floor(Math.random()*out.length)]; if(r.metric===\"temp_c\") r.value=String(r.value).replace(\".\",\",\")+\"C\";}\nmsg.payload = out;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 300,
        "wires": [
            [
                "eadbe2ca52aa9bf2"
            ]
        ]
    },
