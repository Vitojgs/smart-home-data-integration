        "id": "8c4c887286a29c90",
        "type": "function",
        "z": "ef9c7b1f75b201a7",
        "name": "TEMP",
        "func": "let t = context.get('t') ?? 22;\nt += (Math.random() - 0.5) * 0.6;\nt = Math.min(30, Math.max(16, t));\ncontext.set('t', t);\nlet h = 55 + (Math.random() - 0.5) * 4;\nmsg.payload = { device_id: \"TEMP-SA-01\", temp_c: +t.toFixed(1), humidity_pct: +h.toFixed(0) };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
